/*
 * =============================================================================
 * conf/pureTarget.config — pipeline config (between lrsShared.config and finalize.config)
 * Joint PureTarget pipeline: repeat expansion panel + carrier panel (PTCP).
 * =============================================================================
 * The PTCP keys keep their PTCP v1 names (ptcp*), so the PTCP modules, copied
 * unchanged, read them as before.
 *
 * Tool versions, carrier branch vs. PacBio PTCP v3.2.1:
 *   pbmm2      condaEnvs.pbmm2       1.16.99 (26.1.99 with --latestVersions)  PTCP: SMRT Link 25.1
 *   TRGT       condaEnvs.trgt51      5.1.0 (first version with --fail-reads)  PTCP: 5.0.0
 *   Paraphase  condaEnvs.paraphase35 3.5.0                                    PTCP: 3.4.0
 *   Sawfish    condaEnvs.sawfish221  2.2.1                                    PTCP: 2.2.1
 *   ptcp-qc 1.0.0, pbindex, minimap2: condaEnvs.ptcp (env/build_ptcp_env.sh)
 * Repeat branch: as pureTarget v1 (condaEnvs.pbmm2, trgt4, trgt5, pbCPGtools;
 * STRchive catalog params.trDiseaseCatalog).
 * =============================================================================
 */

params {

    // ---- Panel from the testlist ----------------------------------------------
    // Compared with a leading 'SL-' dropped, '_' read as '-', case ignored:
    //   carrier  testlist starts with ptCarrierPrefix (PTCP, PTCP-<anything>),
    //            or is one of ptCarrierTestlists (implementation testlists)
    //   repeat   testlist starts with ptRepeatPrefix (PT-<anything>)
    // Any other testlist is not PureTarget: its sheet rows are skipped (warning)
    // and its uBAMs are never picked up.
    
    ptCarrierPrefix    = 'PTCP-'
    //ptCarrierTestlists = ['PT-KENDT']
    ptRepeatPrefix     = 'PT-'

    dataArchive     = params.dataArchivePureTarget       // shared with pureTarget v1 and PTCP

    // Kept as in pureTarget v1 (the shared default is under nfs_fast_b)
    slurmWorkDir    = "/lnx01_data2/slurmWork/${params.runUser}/${params.traceStamp}_${launchDir.baseName}"
}

// As pureTarget v1: the repeat branch plots every disease locus except DRPLA_ATN1.
params.puretargetPlotGenes = params.puretargetPlotGenes - ['DRPLA_ATN1']


// -----------------------------------------------------------------------------
// Read set and file-name tags
// -----------------------------------------------------------------------------
// readSet names the run folder and the repeat branch files, as in v1
// (<id>.hg38v4LRS.AllReads.trgt5.vcf.gz). The carrier branch keeps the PTCP
// tags (lrsFunctions.nf prefixHifi/prefixFail/prefixStr).
params.readSet      = params.hifiReads ? 'HiFiReads'     : 'AllReads'
params.inputReadSet = params.hifiReads ? 'HifiReads'     : 'HifiAndFail'
params.tagHifi      = 'HifiReads'
params.tagFail      = 'failedReads'
params.strTag       = params.hifiReads ? 'HifiReadsOnly' : 'AllReadsNew'
params.toolsVersion = params.latestVersions ? '_latestToolVersions' : ''


// -----------------------------------------------------------------------------
// Carrier branch (PTCP): scripts, resources, envs, run parameters
// -----------------------------------------------------------------------------
params {

    ptcpVersion          = '3.2.1'      // PacBio PTCP release the scripts and resources come from
    ptcpScripts          = "${params.lrsCustomToolsBase}/ptcp/pacbio"
    ptcpResources        = "${params.lrsCustomToolsBase}/resources/ptcp/v${params.ptcpVersion}"

    // Envs not in lrsShared v1
    condaEnvs {
        ptcp       = "${params.condaLocal}/ptcp/"          // env/build_ptcp_env.sh
        sawfish221 = "${params.condaLocal}/sawfish_221/"
    }

    ptcpTrgtBed          = "${params.ptcpResources}/trgt/PureTarget_repeat_expansion_panel_2.0.repeat_definition.GRCh38.bed"
    ptcpParaphaseConfig  = "${params.ptcpResources}/paraphase/paraphase_config.GRCh38.yaml"
    ptcpVariantList      = "${params.ptcpResources}/variant_list/variant_list.GRCh38.vcf"   // havanno; false = skip
    // ptcp-qc targets, used for BOTH panels: carrier targets + all 37 repeat panel 2.0 loci
    ptcpQcBed            = "${params.ptcpResources}/ptcp-qc/ptcp-qc.GRCh38.bed"
    ptcpSmnRegression    = null      // optional SMN1/2 homology model (JSON)

    ptcpGenomeVersion    = '38'                     // Paraphase / f8_inversion.py --genome
    ptcpHbaRegion        = 'chr16:126123-209491'    // sawfish.wdl, GRCh38 HBA region
    ptcpRepeatPad        = 3000                     // trgt.wdl get_reads_overlapping_repeats expand_size
    ptcpLogLevel         = 'INFO'                   // pbmm2 --log-level

    // ---- Reports (lrsCustomTools summaryScripts/ptcp/) ------------------------
    // true: carrier sample reports + carrier run QC (carrierPanel/reports/), the
    // cell inventory and the run QC report for both panels (reports/).
    // --reports false for a run before the lrsCustomTools release has them.
    reports              = true
    ptcpReportScripts    = "${params.lrsCustomToolsBase}/summaryScripts/ptcp"
    ptcpReportThresholds = null     // YAML/JSON with approved_by + approved_date; null = placeholders
    ptcpReportReference  = null     // carrier target-share reference; null = same-cell comparison
    // CONFIGURED, not probed: keep in step with the conda envs.
    ptcpToolVersions     = [
        [tool: 'pbmm2',     version: params.latestVersions ? '26.1.99' : '1.16.99', ptcp: 'SMRT Link 25.1'],
        [tool: 'TRGT',      version: '5.1.0', ptcp: '5.0.0'],
        [tool: 'Paraphase', version: '3.5.0', ptcp: '3.4.0'],
        [tool: 'Sawfish',   version: '2.2.1', ptcp: '2.2.1'],
        [tool: 'ptcp-qc',   version: '1.0.0', ptcp: '1.0.0'],
    ]
    repeatToolVersions   = [
        [tool: 'pbmm2',        version: params.latestVersions ? '26.1.99' : '1.16.99', note: 'HiFi + fail together (v1)'],
        [tool: 'TRGT',         version: 'condaEnvs.trgt4 + trgt5', note: 'STRchive KGVejle catalog'],
        [tool: 'pb-CpG-tools', version: 'condaEnvs.pbCPGtools', note: 'methylation'],
        [tool: 'ptcp-qc',      version: '1.0.0', note: 'QC only'],
    ]
}


// -----------------------------------------------------------------------------
// Output layout
// -----------------------------------------------------------------------------
//   <outputDirBase>/<sheet>_<readSet>[_latestToolVersions]/
//       repeatExpansion/   pureTarget v1 layout + QC/ptcpQC/
//       carrierPanel/      PTCP v1 layout (incl. QC/ptcpQC/, reports/)
//       QC/cellInventory/  everything on each SMRT Cell
//       reports/           run QC report for both panels
//   <outputDirBase>/runInfo/<yyMMdd>_<sheet>/
// Root: its own folder next to pureTarget/ and pureTargetCarrier/, so the joint
// pipeline can run on the same sheets as the production pipelines.
// --outdir <x> replaces it with <x>_<readSet>, as in v1.
params.outputDirBase = params.outdir
    ? "${params.outdir}_${params.readSet}"
    : "${params.patientsLrsRoot}/${params.genome}/${params.yearStamp}/pureTargetJoint"

// Sample sheet base name, set here because the run folder needs it
// (finalize.config then keeps it). Same rule as finalize.config.
if (!params.ssBase) {
    params.ssBase = params.samplesheet
        ? params.samplesheet.toString().tokenize('/').last().replaceFirst(/\.(txt|csv)$/, '')
        : 'NoSampleSheet'
}

params.panelDirs = [ carrier: 'carrierPanel', repeat: 'repeatExpansion' ]
params.runRoot   = "${params.outputDirBase}/${params.ssBase}_${params.readSet}${params.toolsVersion}"
params.panelOut  = [ carrier: "${params.runRoot}/${params.panelDirs.carrier}",
                     repeat : "${params.runRoot}/${params.panelDirs.repeat}" ]

// The PTCP modules (unchanged) publish ptcp-qc and reports under params.runOutBase
params.runOutBase = params.panelOut.carrier

// Every per-sample publishDir: the sample's panel subtree
params.outBase = { meta -> params.panelOut[meta.panel] }


// -----------------------------------------------------------------------------
// Process overrides
// -----------------------------------------------------------------------------
process {

    // Login shell, stop on the first error, fail a pipe if any part fails.
    // -u is left out: with -l it trips over unset variables in /etc/profile.d.
    withName: '.*' {
        shell = ['/bin/bash', '-l', '-eo', 'pipefail']
    }

    // Bookkeeping on the head node (the repeat branch's aliased copies of
    // create_fofn / inputFiles_symlinks_ubam; lrsShared handles the plain names)
    withName: 'pt_samplesSummary|pt_cellInventory|repeat_create_fofn|repeat_inputFiles_symlinks_ubam' {
        cpus     = 2
        memory   = '4 GB'
        executor = 'local'
        scratch  = false
    }
}
